#!/bin/bash

set -e

if ! command -v error_msg &>/dev/null; then
  source bashHelperKennedyRodrigueFunctions.sh 2>/dev/null || true
  if ! command -v error_msg &>/dev/null; then
    function error_msg() { echo -e "\n[ERROR]\t$*"; }
  fi
fi

# ------------------------------------------------------------------------------
# usage
# ------------------------------------------------------------------------------
function usage() {
  cat << USAGE

Usage: filter_ids [options]

Description:
    Filter subject and session identifiers from CSV files and return matching records or row indices.

Options:
    General / Output:
        --format <visits|bids>        ID format to filter (default: visits)
                                          visits: filters long format visits CSV (7 columns)
                                          bids:   filters long format BIDS CSV (3 columns: study, sub, ses)
        --idx-only <0|1>              Return 1-based row indices only (default: 0)
        -h, --help                    Display this help message

    Common Filters (BIDS & Visits):
        --study <study>               Study name (e.g. jlbs, pams, or all)
        --sub <sub>                   Subject ID (or all)
        --ses <ses>                   Session ID / wave (e.g. 01, 02, or all)

    Visits-Specific Filters (Visits format only):
        --visit-type <type>           Visit type / modality (e.g. 3T, 7T, PET, or all)
        --visit-number <num>          Visit occurrence number (e.g. 1, 2, or all; aliases: --visit_number, --visit-num, --scan)
        --date <date>                 Acquisition date (YYYYMMDD or all)
        --airc-id <id>                AIRC scanner ID (or all)

USAGE
}

# ------------------------------------------------------------------------------
# args
# ------------------------------------------------------------------------------
if [[ $# -eq 0 ]]; then
  usage
  exit 0
fi

# defaults
idx_only=0
format="visits"

vars=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --study)
      study=$2
      if [[ -z ${study} ]]; then
        usage
        error_msg "study value not specified"
        exit 1
      elif [[ ${study} == "all" ]]; then
        study=""
      fi
      vars="${vars} study"
      shift 2
      ;;
    --sub)
      sub=$2
      if [[ -z ${sub} ]]; then
        usage
        error_msg "sub value not specified"
        exit 1
      elif [[ ${sub} == "all" ]]; then
        sub=""
      fi
      vars="${vars} sub"
      shift 2
      ;;
    --ses)
      ses=$2
      if [[ -z ${ses} ]]; then
        usage
        error_msg "ses value not specified"
        exit 1
      elif [[ ${ses} == "all" ]]; then
        ses=""
      fi
      vars="${vars} ses"
      shift 2
      ;;
    --visit-number|--visit_number|--visit-num|--visit_num|--scan)
      visit_number=$2
      if [[ -z ${visit_number} ]]; then
        usage
        error_msg "visit_number value not specified"
        exit 1
      elif [[ ${visit_number} == "all" ]]; then
        visit_number=""
      fi
      vars="${vars} visit_number"
      shift 2
      ;;
    --airc-id)
      airc_id=$2
      if [[ -z ${airc_id} ]]; then
        usage
        error_msg "airc_id value not specified"
        exit 1
      elif [[ ${airc_id} == "all" ]]; then
        airc_id=""
      fi
      vars="${vars} airc_id"
      shift 2
      ;;
    --date)
      date=$2
      if [[ -z ${date} ]]; then
        usage
        error_msg "date value not specified"
        exit 1
      elif [[ ${date} == "all" ]]; then
        date=""
      fi
      vars="${vars} date"
      shift 2
      ;;
    --visit-type|--visit_type)
      visit_type=$2
      if [[ -z ${visit_type} ]]; then
        usage
        error_msg "visit_type value not specified"
        exit 1
      elif [[ ${visit_type} == "all" ]]; then
        visit_type=""
      fi
      vars="${vars} visit_type"
      shift 2
      ;;
    --format)
      format=$2
      if [[ -z ${format} ]]; then
        usage
        error_msg "format value not specified"
        exit 1
      fi
      if [[ ${format} != "visits" ]] && [[ ${format} != "bids" ]]; then
        usage
        error_msg "invalid format value (${format}), must be visits or bids"
        exit 1
      fi
      vars="${vars} format"
      shift 2
      ;;
    --idx-only)
      idx_only=$2
      if [[ -z ${idx_only} ]]; then
        usage
        error_msg "idx_only value not specified"
        exit 1
      fi
      if [[ ${idx_only} -ne 0 ]] && [[ ${idx_only} -ne 1 ]]; then
        usage
        error_msg "invalid idx_only value (${idx_only}), must be 0 or 1"
        exit 1
      fi
      vars="${vars} idx_only"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo -e "\n\tunknown option: $1"
      usage
      exit 1
      ;;
  esac
done

if [[ ${format} == "bids" ]]; then
  if [[ -n ${visit_number} ]] || [[ -n ${airc_id} ]] || [[ -n ${date} ]] || [[ -n ${visit_type} ]]; then
    usage
    error_msg "--visit-number, --airc-id, --date, and --visit-type cannot be used with --format bids"
    exit 1
  fi
fi

# ------------------------------------------------------------------------------
# paths
# ------------------------------------------------------------------------------
root_dir=`get_root_dir kenrod`
if [[ ${format} == "bids" ]]; then
  in_ids="${root_dir}/software/scripts/eep170030/ids_study-all_format-long-bids.csv"
else
  in_ids="${root_dir}/software/scripts/eep170030/ids_study-all_format-long-visits.csv"
fi

# ------------------------------------------------------------------------------
# check paths
# ------------------------------------------------------------------------------
check_in_paths ${in_ids}

# ------------------------------------------------------------------------------
# main
# ------------------------------------------------------------------------------
# Read the column names from the header line
header=$(head -n 1 "$in_ids")

# Extract the column indices dynamically
study_col=$(echo "${header}" | awk -F, '{ for (i = 1; i <= NF; i++) if ($i == "study") print i }')
subj_col=$(echo "${header}" | awk -F, '{ for (i = 1; i <= NF; i++) if ($i == "sub") print i }')
ses_col=$(echo "${header}" | awk -F, '{ for (i = 1; i <= NF; i++) if ($i == "ses") print i }')
visit_number_col=$(echo "${header}" | awk -F, '{ for (i = 1; i <= NF; i++) if ($i == "visit_number" || $i == "visit_num" || $i == "scan") print i }')
airc_id_col=$(echo "${header}" | awk -F, '{ for (i = 1; i <= NF; i++) if ($i == "airc_id") print i }')
date_col=$(echo "${header}" | awk -F, '{ for (i = 1; i <= NF; i++) if ($i == "date") print i }')
visit_type_col=$(echo "${header}" | awk -F, '{ for (i = 1; i <= NF; i++) if ($i == "visit_type") print i }')

# Only check if a column exists IF the user explicitly filtered by it
if [[ -n ${study} ]] && [[ -z ${study_col} ]]; then
  error_msg "column 'study' not found in ${in_ids}"
  exit 1
fi
if [[ -n ${sub} ]] && [[ -z ${subj_col} ]]; then
  error_msg "column 'sub' not found in ${in_ids}"
  exit 1
fi
if [[ -n ${ses} ]] && [[ -z ${ses_col} ]]; then
  error_msg "column 'ses' not found in ${in_ids}"
  exit 1
fi
if [[ -n ${visit_number} ]] && [[ -z ${visit_number_col} ]]; then
  error_msg "column 'visit_number' (or 'scan') not found in ${in_ids}"
  exit 1
fi
if [[ -n ${airc_id} ]] && [[ -z ${airc_id_col} ]]; then
  error_msg "column 'airc_id' not found in ${in_ids}"
  exit 1
fi
if [[ -n ${date} ]] && [[ -z ${date_col} ]]; then
  error_msg "column 'date' not found in ${in_ids}"
  exit 1
fi
if [[ -n ${visit_type} ]] && [[ -z ${visit_type_col} ]]; then
  error_msg "column 'visit_type' not found in ${in_ids}"
  exit 1
fi

# Read the CSV file and filter lines based on arguments
if [[ ${idx_only} == 0 ]]; then
  awk \
  -F, \
  -v study="${study}" \
  -v subj="${sub}" \
  -v ses="${ses}" \
  -v visit_number="${visit_number}" \
  -v airc_id="${airc_id}" \
  -v date="${date}" \
  -v visit_type="${visit_type}" \
  -v study_col="${study_col}" \
  -v subj_col="${subj_col}" \
  -v ses_col="${ses_col}" \
  -v visit_number_col="${visit_number_col}" \
  -v airc_id_col="${airc_id_col}" \
  -v date_col="${date_col}" \
  -v visit_type_col="${visit_type_col}" \
  ' \
  NR > 1 && \
  (study == "" || (study_col != "" && $study_col == study)) && \
  (subj == "" || (subj_col != "" && $subj_col == subj)) && \
  (ses == "" || (ses_col != "" && $ses_col == ses)) && \
  (visit_number == "" || (visit_number_col != "" && $visit_number_col == visit_number)) && \
  (airc_id == "" || (airc_id_col != "" && $airc_id_col == airc_id)) && \
  (date == "" || (date_col != "" && $date_col == date)) && \
  (visit_type == "" || (visit_type_col != "" && $visit_type_col == visit_type)) \
  {
      print FNR - 1 "," $0;
  }
  ' "${in_ids}"
elif [[ ${idx_only} -eq 1 ]]; then
  row_numbers=`awk \
  -F, \
  -v study="${study}" \
  -v subj="${sub}" \
  -v ses="${ses}" \
  -v visit_number="${visit_number}" \
  -v airc_id="${airc_id}" \
  -v date="${date}" \
  -v visit_type="${visit_type}" \
  -v study_col="${study_col}" \
  -v subj_col="${subj_col}" \
  -v ses_col="${ses_col}" \
  -v visit_number_col="${visit_number_col}" \
  -v airc_id_col="${airc_id_col}" \
  -v date_col="${date_col}" \
  -v visit_type_col="${visit_type_col}" \
  ' \
  NR > 1 && \
  (study == "" || (study_col != "" && $study_col == study)) && \
  (subj == "" || (subj_col != "" && $subj_col == subj)) && \
  (ses == "" || (ses_col != "" && $ses_col == ses)) && \
  (visit_number == "" || (visit_number_col != "" && $visit_number_col == visit_number)) && \
  (airc_id == "" || (airc_id_col != "" && $airc_id_col == airc_id)) && \
  (date == "" || (date_col != "" && $date_col == date)) && \
  (visit_type == "" || (visit_type_col != "" && $visit_type_col == visit_type)) \
  {
      print FNR - 1;
  }
  ' "$in_ids" | tr '\n' ' ' | sed 's/ /,/g' | sed 's/,$//g'`
  echo "${row_numbers}"
fi
