#!/bin/bash

# ------------------------------------------------------------------------------
# modules
# ------------------------------------------------------------------------------
module load bashHelperKennedyRodrigue
source bashHelperKennedyRodrigueFunctions.sh

# ------------------------------------------------------------------------------
# opts
# ------------------------------------------------------------------------------
set -e
study_list=(all jlbs pams)
format_list=(visits bids)

declare -A wave_list
wave_list[jlbs]="all 1 2 3 4"
wave_list[pams]="all"

declare -A visit_type_list
visit_type_list[jlbs-all]="all 3T 7T"
visit_type_list[jlbs-1]="all 3T"
visit_type_list[jlbs-2]="all 3T"
visit_type_list[jlbs-3]="all 3T"
visit_type_list[jlbs-4]="all 3T 7T"
visit_type_list[pams-all]="all 3T PET"
visit_type_list[pams-1]="all 3T PET"


date_str=`date +%Y-%m-%d`
logs_pwd="${root_dir}/server/logs/${USER}/${date_str}"

declare -a slurm_opts
# slurm_opts[0]="''"
slurm_opts[1]="--nodes=1 \
--ntasks=1 \
--cpus-per-task=1 \
--mem=8G \
--time=24:00:00 \
--output=${logs_pwd}/jid-%j_jname-%x.log \
--job-name=flex"

slurm_opts[2]="--nodes=1 \
--ntasks=1 \
--cpus-per-task=1 \
--mem=8G \
--time=24:00:00 \
--output=${logs_pwd}/jid-%j_jname-%x.log \
--partition=kenrod \
--job-name=flex"

slurm_opts[3]="--nodes=1 \
--ntasks=1 \
--cpus-per-task=1 \
--mem=8G \
--time=24:00:00 \
--output=${logs_pwd}/jid-%j_jname-%x.log \
--partition=dev \
--job-name=flex"

slurm_opts[4]="--nodes=1 \
--ntasks=1 \
--cpus-per-task=1 \
--mem=16G \
--time=24:00:00 \
--output=${logs_pwd}/jid-%j_jname-%x.log \
--job-name=flex"

slurm_opts[5]="--nodes=1 \
--ntasks=1 \
--cpus-per-task=1 \
--mem=16G \
--time=24:00:00 \
--output=${logs_pwd}/jid-%j_jname-%x.log \
--partition=kenrod \
--job-name=flex"

slurm_opts[6]="--nodes=1 \
--ntasks=1 \
--cpus-per-task=1 \
--mem=16G \
--time=24:00:00 \
--output=${logs_pwd}/jid-%j_jname-%x.log \
--partition=dev \
--job-name=flex"

declare -a slurm_opts_desc
slurm_opts_desc[1]="general (default)"
slurm_opts_desc[2]="general (partition: kenrod)"
slurm_opts_desc[3]="general (partition: dev)"
slurm_opts_desc[4]="high-memory"
slurm_opts_desc[5]="high-memory (partition: kenrod)"
slurm_opts_desc[6]="high-memory (partition: dev)"

# slurm_default_opts="--nodes=1 \
# --ntasks=1 \
# --cpus-per-task=1 \
# --mem-per-cpu=8G \
# --time=24:00:00 \
# --output=${logs_pwd}/jid-%j_jname-%x.log \
# --job-name=flex"

# sge_default_opts="-V \
# -S /bin/bash \
# -o jid-\$JOB_ID-\$TASK_ID_jname-\$JOB_NAME.log \
# -j y"

sge_default_opts="-j y \
-wd ${logs_pwd}"

# ------------------------------------------------------------------------------
# paths
# ------------------------------------------------------------------------------
root_dir=`get_root_dir kenrod`

declare -A in_paths
in_paths[preproc]="${root_dir}/software/scripts/eep170030/script_sets.txt"
in_paths[ids_visits]="${root_dir}/software/scripts/eep170030/ids_study-all_format-long-visits.csv"
in_paths[ids_bids]="${root_dir}/software/scripts/eep170030/ids_study-all_format-long-bids.csv"

in_scripts=(`cat ${in_paths[preproc]} | sort`)

# ------------------------------------------------------------------------------
# main
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# pipelines
# ------------------------------------------------------------------------------
echo -e "\npipelines:"
for i in ${!in_scripts[@]}; do
    scripts_idx1=$((i+1))
    echo -e "\t${scripts_idx1}:\t${in_scripts[i]}"
done
echo -e "\n[NOTE]:\t\tif you want to add a new pipeline, add it to the pipeline file (path: ${in_paths[preproc]})"

scripts_idx_opts=`seq 1 $((${#in_scripts[@]}))`
scripts_idx=$(get_valid_input \
-p "which pipeline do you want to run? (enter index number)" \
-o ${scripts_idx_opts} \
-e 0)

scripts_idx1=${scripts_idx}
scripts_idx=$((scripts_idx-1))
echo -e "pipeline[${scripts_idx1}]:\t${in_scripts[$scripts_idx]}"

# ------------------------------------------------------------------------------
# script
# ------------------------------------------------------------------------------
echo -e "\nscripts:"
in_script_set=`eval echo ${in_scripts[scripts_idx]}`
in_script=(`cat ${in_script_set}`)
if [[ ${#in_script[@]} -lt 1 ]]; then
    error_msg "no scripts found for ${in_script_set}"
fi
for i in ${!in_script[@]}; do
    i_str=$((i+1))
    echo -e "\t${i_str}:\t${in_script[i]} [${i_str}]"
done
script_idx_opts=`seq 1 $((${#in_script[@]}))`
script_idx=$(get_valid_input \
-p "which script do you want to run? (enter index number)" \
-o ${script_idx_opts} \
-e 0)


scripts_idx_tmp=$((script_idx-1))
echo -e "script[${script_idx}]:\t${in_script[$scripts_idx_tmp]}"

# ------------------------------------------------------------------------------
# study
# ------------------------------------------------------------------------------
echo -e "\nstudies:"
for i in ${!study_list[@]}; do
    echo -e "\t${i}:\t${study_list[i]}"
done
study_idx_opts=`seq 0 $((${#study_list[@]}-1))`
study_idx=$(get_valid_input \
-p "which study do you want to run? (enter index number or hit enter to use default; default: 0 [all])" \
-o ${study_idx_opts} \
-e 1 \
-d 0)
study=${study_list[$study_idx]}
echo -e "study[${study_idx}]:\t${study}"

# ------------------------------------------------------------------------------
# format
# ------------------------------------------------------------------------------
echo -e "\nformats:"
for i in ${!format_list[@]}; do
    echo -e "\t${i}:\t${format_list[i]}"
done
format_idx_opts=`seq 0 $((${#format_list[@]}-1))`
format_idx=$(get_valid_input \
-p "which format do you want to run? (enter index number or hit enter to use default; default: 0 [visits])" \
-o ${format_idx_opts} \
-e 1 \
-d 0)
format=${format_list[$format_idx]}
echo -e "format[${format_idx}]:\t${format}"

in_paths[ids]="${in_paths[ids_${format}]}"
if [[ -z ${in_paths[ids]} ]]; then
    in_paths[ids]="${in_paths[ids_visits]}"
fi

# ------------------------------------------------------------------------------
# session
# ------------------------------------------------------------------------------
echo -e "\nsessions:"
ses_list=(`echo ${wave_list[${study}]}`)
if [[ ${study} == 'all' ]]; then
    ses_list=(`echo ${wave_list[jlbs]} ${wave_list[pams]}`)
    ses_idx=0
elif [[ ${#ses_list[@]} -lt 1 ]]; then
    error_msg "no sessions found for ${study}"
else
    for i in ${!ses_list[@]}; do
        echo -e "\t${i}:\t${ses_list[$i]}"
    done
    ses_idx_opts=`seq 0 $((${#ses_list[@]}-1))`
    ses_idx=$(get_valid_input \
    -p "which session do you want to run? (enter index number or hit enter to use default; default: 0 [all])" \
    -o ${ses_idx_opts} \
    -e 1 \
    -d 0)
fi
echo "session[${ses_idx}]: ${ses_list[$ses_idx]}"
ses=${ses_list[$ses_idx]}
if [[ ${ses} =~ ^[0-9]$ ]]; then
    ses=`printf "%02d" ${ses}`
fi

# ------------------------------------------------------------------------------
# visit_type
# ------------------------------------------------------------------------------
if [[ ${format} != "bids" ]]; then
    ses_key=${ses#0}
    ses_key=${ses_key:-all}
    key="${study}-${ses_key}"
    visit_type_opts=(`echo ${visit_type_list[${key}]}`)

    if [[ ${#visit_type_opts[@]} -lt 1 ]]; then
        if [[ ${study} == "all" ]]; then
            visit_type_opts=("all" $(echo ${visit_type_list[jlbs-all]} ${visit_type_list[pams-all]} | tr ' ' '\n' | grep -v '^all$' | sort -u))
        else
            visit_type_opts=(`echo ${visit_type_list[${study}-all]}`)
        fi
    fi

    # Fallback to dynamic extraction via filter_ids if still empty
    if [[ ${#visit_type_opts[@]} -lt 1 ]]; then
        raw_types=($(filter_ids --study ${study} --ses ${ses} --format visits | awk -F, '{print $NF}' | grep -v '^all$' | grep -v '^$' | sort -u))
        if [[ ${#raw_types[@]} -gt 0 ]]; then
            visit_type_opts=("all" "${raw_types[@]}")
        fi
    fi

    if [[ ${#visit_type_opts[@]} -gt 1 ]]; then
        echo -e "\nvisit types:"
        for i in ${!visit_type_opts[@]}; do
            echo -e "\t${i}:\t${visit_type_opts[i]}"
        done
        visit_type_idx_opts=`seq 0 $((${#visit_type_opts[@]}-1))`
        visit_type_idx=$(get_valid_input \
        -p "which visit type do you want to run? (enter index number or hit enter to use default; default: 0 [all])" \
        -o ${visit_type_idx_opts} \
        -e 1 \
        -d 0)
        visit_type=${visit_type_opts[$visit_type_idx]}
    elif [[ ${#visit_type_opts[@]} -eq 1 ]]; then
        visit_type=${visit_type_opts[0]}
    else
        visit_type="all"
    fi
    echo -e "visit_type:\t${visit_type}"
else
    visit_type=""
fi

# ------------------------------------------------------------------------------
# ids using filter
# ------------------------------------------------------------------------------
filter_args="--study ${study} --ses ${ses} --format ${format}"
if [[ ${format} != "bids" ]] && [[ -n ${visit_type} ]]; then
    filter_args="${filter_args} --visit-type ${visit_type}"
fi

in_ids=(`filter_ids ${filter_args}`)
if [[ ${#in_ids[@]} -lt 1 ]]; then
    error_msg "no ids found for ${study} (ses: ${ses}, format: ${format}, visit_type: ${visit_type})"
fi
echo ""
ids_idx_opts=()
for i in ${!in_ids[@]}; do
    i_str=`echo ${in_ids[$i]} | awk -F, '{print $1}'`
    ids_idx_opts+=(${i_str})
    echo -e "\t${i_str}:\t${in_ids[i]}"
done
echo -e "\tall:\tall"
echo -e "\ttest-1:\ttest first subject"
echo -e "\ttest-3:\ttest first three subjects"

# note: can't use get_valid_input because of the comma and semicolon input options
echo -en "\n[$(get_datetime)] [PROMPT]\twhich subjects do you want to run? (enter index number or hit enter to use default; default: all)\n"
read -r ids_idx
if [[ -z ${ids_idx} ]] || [[ ${ids_idx} == 'all' ]]; then
    echo "ids_idx: all"
    ids_idx=`filter_ids ${filter_args} --idx-only 1`
elif [[ ${ids_idx} == 'test-1' ]]; then
    echo "ids_idx: test-1"
    ids_idx=`filter_ids ${filter_args} --idx-only 1`
    ids_idx=(`echo ${ids_idx} | tr ',' ' '`)
    ids_idx=${ids_idx[0]}
elif [[ ${ids_idx} == 'test-3' ]]; then
    echo "ids_idx: test-3"
    ids_idx=`filter_ids ${filter_args} --idx-only 1`
    ids_idx=(`echo ${ids_idx} | tr ',' ' '`)
    ids_idx=(${ids_idx[@]:0:3})
    ids_idx=$(IFS=,; echo "${ids_idx[*]}")
fi
echo "ids_idx: ${ids_idx}"

# ------------------------------------------------------------------------------
# extra options
# ------------------------------------------------------------------------------
echo -en "\n[$(get_datetime)] [PROMPT]\textra options? (enter number or hit enter to use default; default: none)\n"
read -r extra_opts
if [[ -z ${extra_opts} ]] || [[ ${extra_opts} == 'none' ]]; then
    extra_opts="''"
else
    extra_opts="'${extra_opts}'"
fi
echo -e "extra_opts:\t${extra_opts}"

# ------------------------------------------------------------------------------
# parallel
# ------------------------------------------------------------------------------
echo -e "\nparallel engines:"
pe_list=(0 sge slurm)
for i in ${!pe_list[@]}; do
    echo -e "\t${i}:\t${pe_list[i]}"
done
pe_idx_opts=`seq 0 $((${#pe_list[@]}-1))`
pe_idx=$(get_valid_input \
-p "which parallel environment do you want to run? (enter index number or hit enter to use default; default: 0 [none])" \
-o ${pe_idx_opts} \
-e 1 \
-d 0)

echo "parellel engine[${pe_idx}]: ${pe_list[$pe_idx]}"

if [[ ${pe_idx} -gt 0 ]]; then
    echo -e "\nBefore running parallel jobs using the parallel engine, please consider the following:"
    echo -e "- please ensure that the parallel settings are properly configured in the script, especially if using none. for more details, please see the following link:\n\thttps://kennedy-rodrigue-wiki.readthedocs.io/en/latest/server.html#parallel-jobs"
    echo -e "- please test a single subject first to ensure the job is running as expected"
    echo -e "\nparallel engine arguments:\n\t0:\tnone"
    if [[ ${pe_idx} -eq 1 ]]; then
        echo -e "${pe_opts_str}\t1:\t${sge_default_opts}"
    elif [[ ${pe_idx} -eq 2 ]]; then
        for i in ${!slurm_opts[@]}; do
            echo -e "\t${i}:\t${slurm_opts_desc[$i]}\t${slurm_opts[$i]}"
        done
        # echo -e "${pe_opts_str}\t1:\t${slurm_default_opts}"
    fi
    echo -en "\n[$(get_datetime)] [PROMPT]\tparallel opts? (enter additional parallel engine arguments, use one of the predefined options, or hit enter to use the default option; default: 1) \n"
    read -r pe_opts

    if [[ ${pe_idx} -eq 1 ]] && [[ -z ${pe_opts} ]]; then
    pe_opts="'${sge_default_opts}'"
    elif [[ ${pe_idx} -eq 1 ]] && [[ $(is_numeric ${pe_opts}) -eq 1 ]]; then
        if [[ ${pe_opts} -gt ${#sge_opts[@]} ]]; then
            warning_msg "not a valid sge option (${pe_opts}), using default (1)"
            pe_opts="'${sge_default_opts}'"
        fi
    elif [[ ${pe_idx} -eq 2 ]] && [[ -z ${pe_opts} ]]; then
        pe_opts="'${slurm_opts[1]}'"
    elif [[ ${pe_idx} -eq 2 ]] && [[ $(is_numeric ${pe_opts}) -eq 1 ]]; then
        if [[ ${pe_opts} -gt ${#slurm_opts[@]} ]]; then
            warning_msg "not a valid slurm option (${pe_opts}), using default (1)"
            pe_opts="'${slurm_opts[1]}'"
        else 
            pe_opts="'${slurm_opts[${pe_opts}]}'"
        fi
    else
        pe_opts="'${pe_opts}'"
    fi
    echo -e "parallel opts:\t${pe_opts}"
fi


if [[ ${pe_idx} -gt 0 ]]; then
    pe_job_limit_opts=`seq 0 32`
    pe_job_limit=$(get_valid_input \
    -p "parallel job limit? (enter number or hit enter to use default; default: 16)" \
    -o ${pe_job_limit_opts} \
    -e 1 \
    -d 16)
    echo -e "parallel job limit: ${pe_job_limit}"
fi

# ------------------------------------------------------------------------------
# overwrite
# ------------------------------------------------------------------------------
overwrite=$(get_valid_input \
-p "do you want to overwrite output files? (enter 0 or 1 or hit enter to use default; default: 0 [no])" \
-o 0 1 \
-e 1 \
-d 0)
echo -e "overwrite:\t${overwrite}"

# ------------------------------------------------------------------------------
# cmd
# ------------------------------------------------------------------------------
in_script_run=`eval echo ${in_scripts[scripts_idx]}`
cmd="flex_wrapper \
--in-scripts ${in_script_run} \
--in-ids ${in_paths[ids]} \
--scripts-idx ${script_idx} \
--ids-idx ${ids_idx} \
--overwrite ${overwrite}"
if [[ ! -z ${extra_opts} ]]; then
    cmd="${cmd} \
    --extra-opts ${extra_opts}"
fi
if [[ ${pe_idx} -gt 0 ]]; then
    cmd="${cmd} \
    --parallel ${pe_list[${pe_idx}]} \
    --parallel-opts ${pe_opts} \
    --parallel-job-limit ${pe_job_limit}"
fi
cmd="${cmd} \
--print 1"
echo -e "\ncommand:\n${cmd}\n"
eval ${cmd} 
#| head -n 100
# echo -e "...\n[INFO]\t\tdisplaying only the first 200 lines"

# ------------------------------------------------------------------------------
# execute
# ------------------------------------------------------------------------------
cmd=`echo ${cmd} | sed 's/--print 1/--print 0/'`
run=$(get_valid_input \
-p "ok to run? (enter 0 or 1 or hit enter to use default; default: 0 [no])" \
-o 0 1 \
-e 1 \
-d 0)
echo -e "run:\t${run}"

if [[ ${run} -eq 1 ]]; then
    eval ${cmd}
else
    warning_msg "not running"
fi
