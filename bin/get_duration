#!/bin/bash

# help
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    echo "Usage: get_duration <seconds>"
    exit 0
fi

duration=${1:-0}
if [[ ! ${duration} =~ ^[0-9]+$ ]]; then
    duration=0
fi

printf '%d:%02d:%02d:%02d\n' "$((duration/86400))" "$((duration%86400/3600))" "$((duration%3600/60))" "$((duration%60))"