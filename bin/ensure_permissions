#!/bin/bash

# ------------------------------------------------------------------------------
# usage
# ------------------------------------------------------------------------------
usage() {
    cat <<USAGE
    
    Usage: $0 <path> [path2 ...]

        path can be a file or directory

    Description:

        ensures the following:
            - directories:  chmod 2775 permissions
            - files:        chmod 0774 permissions
            - ACLs:         recursively strips ACL permissions (+ endings)
            - group:        if group ownership is kenrod, then changes to kenrodbasic or kenrodusers depending on group membership

USAGE
    exit 1
}

# ------------------------------------------------------------------------------
# args
# ------------------------------------------------------------------------------
if [[ $# -lt 1 ]]; then
    usage
fi

# ------------------------------------------------------------------------------
# functions
# ------------------------------------------------------------------------------
OS=$(uname)

# Determine the target group based on current user group membership
group_list=$(groups)
max_grp=""
if [[ " ${group_list} " =~ " kenrodusers " ]]; then
    max_grp="kenrodusers"
elif [[ " ${group_list} " =~ " kenrodbasic " ]]; then
    max_grp="kenrodbasic"
fi

# Helper function to get the owner of a file/directory (OS agnostic)
get_owner() {
    if [[ ${OS} == "Darwin" ]]; then
        stat -f '%Su' "$1"
    else
        stat -c '%U' "$1"
    fi
}

# Helper function to get the group of a file/directory (OS agnostic)
get_group() {
    if [[ ${OS} == "Darwin" ]]; then
        stat -f '%Sg' "$1"
    else
        stat -c '%G' "$1"
    fi
}

# Helper function to recursively strip ACLs (OS agnostic)
strip_acl() {
    local target="$1"
    if [[ ${OS} == "Darwin" ]]; then
        chmod -R -N "${target}" 2>/dev/null
    elif [[ ${OS} == "Linux" ]]; then
        setfacl -R -b "${target}" 2>/dev/null
    fi
}

# ------------------------------------------------------------------------------
# main
# ------------------------------------------------------------------------------
# Iterate through each argument directly to safely support spaces in paths
for path in "$@"; do

    if [[ ! -e ${path} ]]; then
        warning_msg "skipping, path does not exist\n\t path:\t${path}"
        continue
    fi

    # Check ownership using native Bash test first (fast and process-free)
    if [[ ! -O ${path} ]]; then
        path_owner=$(get_owner "${path}")
        warning_msg "skipping, permissions cannot be modified because file owner does not match user\n\t user:\t${USER}\n\t owner:\t${path_owner}\n\t path:\t${path}"
        continue
    fi

    # Batch change permissions (using '+' instead of '\;') to process in batches.
    # Restrict to user's files to prevent permission errors on subfiles owned by others.
    find "${path}" -user "${USER}" -type d -exec chmod 2775 {} +
    find "${path}" -user "${USER}" -type f -exec chmod 0774 {} +

    # Recursively strip ACL permissions
    strip_acl "${path}"

    # Update group if top-level path group is kenrod and a target group is found
    if [[ -n ${max_grp} ]]; then
        grp=$(get_group "${path}")
        if [[ ${grp} == "kenrod" ]]; then
            find "${path}" -user "${USER}" -exec chgrp "${max_grp}" {} +
        fi
    fi
done